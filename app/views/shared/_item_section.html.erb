<div class="mb-5" data-filter-target="item<%= section.capitalize %>">
  <!-- Barre de recherche -->
  <div class="mt-2 mb-4">
    <%= render "shared/search_bar", path: homepage_path(category: @category.name), target_name: 'searchInput', action_name: "keyup->refresh-list#update"  %>
  </div>

  <!-- Cartes des catégories -->
  <div class="subcategory-cards-container mb-2">
    <%= render "shared/card_subcategory", subcategories: @subcategories %>
  </div>

  <div class="active-filter-container">
    <% if params[:subcategory].present? %>
      <div class="active-filter">
        <span>Filter: <strong><%= params[:subcategory].capitalize %></strong></span>
        <%= link_to "Remove filter", homepage_path(category: @category.name), class: "remove-filter-btn" %>
      </div>
    <% end %>
  </div>

  <p class="my-3"><strong><%= @category.name.capitalize %> from people living nearby</strong></p>

  <div data-refresh-list-target="list">
    <!-- Cartes des items -->
    <div class="item-cards-container mb-2">
      <%= render "shared/card_item", items: items %>
    </div>

    <p class="my-3"><strong>All <%= @category.name %> from the community</strong></p>

    <!-- Cartes des items -->
    <div class="item-cards-container mb-2">
      <%= render "shared/card_item", items: items %>
    </div>
  </div>

  <!-- Boutons d'actions -->
  <% if section == "Request" %>
    <div class="d-flex flex-column align-items-center">
      <button class="btn-blue mb-2"><h2><%= @category.name == 'food' ? 'Share your extra food' : 'Share an object'%></h2></button>
      <button class="btn-white-border-blue mb-2"><h2><%= @category.name == 'food' ? 'Request a food item' : 'Request an object'%></h2></button>
    </div>
  <% end %>
</div>
